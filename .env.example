# ⚠️ WARNING: DO NOT COMMIT REAL SECRETS TO GIT
# Ensure ADMIN_PASSWORD and JWT_SECRET are changed for production deployments!

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication (MUST change JWT_SECRET in production!)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin Seed Account (MUST change ADMIN_PASSWORD in production!)
ADMIN_EMAIL=admin@marutinova.com
ADMIN_PASSWORD=change-this-password-in-production

# Database
DB_PATH=./data/marutinovatech.db
