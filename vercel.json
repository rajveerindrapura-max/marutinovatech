{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/sql-lab", "destination": "/sql.html" },
    { "source": "/sql", "destination": "/sql.html" },
    { "source": "/playground", "destination": "/sql.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/python", "destination": "/python.html" },
    { "source": "/python-lab", "destination": "/python.html" },
    { "source": "/powerbi", "destination": "/powerbi.html" },
    { "source": "/pyspark", "destination": "/pyspark.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
